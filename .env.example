# Docker: cu128 for RTX 50 / Blackwell; cu124 for the original FaceLift stack.
CUDA_PROFILE=cu128
GPU_DEVICE_ID=0
# Two GPUs: set COMPOSE_PROFILES=multi-gpu (one worker / job per GPU).
COMPOSE_PROFILES=
GPU_DEVICE_ID_2=1
# Optional CUDA extension architecture override, e.g. CUDA_ARCH_LIST=12.0
CUDA_ARCH_LIST=
DOCKER_BUILD_JOBS=2
# OrbitHead builds COLMAP/OpenMVS in Docker. 86 = RTX 30; set 120 for RTX 50 if needed.
ORBITHEAD_CUDA_ARCH=86
ORBITHEAD_BUILD_JOBS=2
# Keep this greater than WORKER_SHUTDOWN_SECONDS (allow at least 30 extra seconds).
WORKER_STOP_GRACE_PERIOD=330s

# Native launch: relative paths resolve from the current working directory.
# Compose overrides these two paths with container paths.
# Pipe, comma or whitespace separated: facelift, orbithead, or orbithead|facelift.
WORKER_PROCESSOR=facelift
FACELIFT_PATH=./worker_processors/FaceLift
ORBITHEAD_PATH=./worker_processors/orbithead
# Defaults follow OrbitHead CLI. Worker always adds --no-preview --clean.
# In Compose only one GPU is exposed: keep ORBITHEAD_GPU=0, select host GPU via GPU_DEVICE_ID.
ORBITHEAD_GPU=0
ORBITHEAD_GEOMETRY=da3
ORBITHEAD_FRAMES=48
ORBITHEAD_DA3_RES=756
ORBITHEAD_JPEG=92
ORBITHEAD_TEXTURE_SIZE=8192
ORBITHEAD_CARVE=0
ORBITHEAD_MASKED_SFM=0
# Optional native interpreter override; default: ORBITHEAD_PATH/.venv/bin/python.
# ORBITHEAD_PYTHON=/absolute/path/to/orbithead/.venv/bin/python
WORKER_TEMP_ROOT=./worker-temp
# Debug only: keep failed attempt-* directories under WORKER_TEMP_ROOT for inspection.
WORKER_PRESERVE_FAILED_ATTEMPTS=0
WORKER_SHUTDOWN_SECONDS=300

# Worker-only role. PostgreSQL TLS uses verify-full by default.
DATABASE_URL=
# Must match the channel used by backend NOTIFY (worker_api/v1 default).
DATABASE_NOTIFY_CHANNEL=metology_jobs

# Optional SSH forwarding implemented inside Python with AsyncSSH.
SSH_TUNNEL_ENABLED=0
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Docker SSH overlay: absolute HOST paths, without ~; mounted read-only in the container.
# PowerShell example: C:/Users/Ilya/.ssh/id_ed25519 (use forward slashes).
# WSL/Linux example: /home/user/.ssh/id_ed25519
SSH_KEY_PATH=
SSH_KNOWN_HOSTS_PATH=~/.ssh/known_hosts
SSH_KEY_PASSPHRASE=
# 0 selects a free local port automatically; the worker rewrites DATABASE_URL internally.
SSH_LOCAL_PORT=15432
SSH_REMOTE_HOST=127.0.0.1
SSH_REMOTE_PORT=5432
# disable: SSH terminates on the database host; verify-full: PostgreSQL TLS through SSH.
SSH_DATABASE_SSLMODE=disable

# For a private CA set PGSSLROOTCERT=/absolute/path/to/ca.pem in the environment.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Only for a local test database/MinIO, never production.
WORKER_ALLOW_INSECURE=0
